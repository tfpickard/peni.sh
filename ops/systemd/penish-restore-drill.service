[Unit]
Description=penish restore drill
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/peni.sh
ExecStart=/usr/local/bin/penish-restore-drill
# The script has its own limit on the restore; this one covers a hung docker daemon.
TimeoutStartSec=20min
# Shares a small box with the live stack.
Nice=10
IOSchedulingClass=idle
