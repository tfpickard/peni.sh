# Image tag for all penish-* images. The deploy poller rewrites this to the git sha.
IMAGE_TAG=dev
# Postgres password. Keep it URL-safe (no @ : / ?), it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Claude API key for the worker's describer. Unset skips model-generated text.
ANTHROPIC_API_KEY=
# Other providers, used only by a purpose whose model id starts openai:, openrouter: or xai:.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
# Password for /admin. Unset and the page does not exist.
ADMIN_PASSWORD=
# Keys the hashes of voter ids and comment IPs. Generate with: openssl rand -hex 32
# Changing it later orphans every existing vote.
SECRET_KEY=
# Cloudflare Turnstile for comments. Both or neither; unset leaves only the rate limit.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# The tag cloud shows the TAG_CLOUD_LIMIT most used tags that sit on at least TAG_CLOUD_MIN
# pictures. Unset means 60 and 2; raise the floor as the corpus grows.
TAG_CLOUD_LIMIT=
TAG_CLOUD_MIN=
# No tunnel token here: the tunnel runs as host cloudflared.service (token in /etc/cloudflared/token),
# with the public hostname pointed at http://localhost:8000.
# Fine-grained GitHub token, Actions read-only on tfpickard/peni.sh. Used by penish-deploy.
GH_READ_TOKEN=
# restic repo, e.g. s3:https://<account>.r2.cloudflarestorage.com/<bucket>. Unset falls back to rsync.
RESTIC_REPOSITORY=
# Passphrase that encrypts the restic repo. Losing it loses the backups.
RESTIC_PASSWORD=
# R2 API token credentials, read by restic through its S3 backend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 has no regions; restic's S3 backend wants one set.
AWS_DEFAULT_REGION=auto

# Image notes: tags penish-api, penish-worker and penish-migrate are all built from the one
# Dockerfile (targets api, worker, migrate). CI must push all three or migrate will not pull.
