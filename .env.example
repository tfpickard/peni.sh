# Image tag for all penish-* images. The deploy poller rewrites this to the git sha.
IMAGE_TAG=dev
# Postgres password. Keep it URL-safe (no @ : / ?), it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Claude API key for the worker's describer. Unset skips model-generated text.
ANTHROPIC_API_KEY=
# Cloudflare Tunnel token. Required in prod only; dev skips cloudflared.
TUNNEL_TOKEN=
# Fine-grained GitHub token, Actions read-only on tfpickard/peni.sh. Used by penish-deploy.
GH_READ_TOKEN=
# restic repo, e.g. s3:https://<account>.r2.cloudflarestorage.com/<bucket>. Unset falls back to rsync.
RESTIC_REPOSITORY=
# Passphrase that encrypts the restic repo. Losing it loses the backups.
RESTIC_PASSWORD=
# R2 API token credentials, read by restic through its S3 backend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 has no regions; restic's S3 backend wants one set.
AWS_DEFAULT_REGION=auto

# Image notes: tags penish-api, penish-worker and penish-migrate are all built from the one
# Dockerfile (targets api, worker, migrate). CI must push all three or migrate will not pull.
