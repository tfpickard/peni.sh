#!/usr/bin/env bash
# Pull-based deploy poller. Run by penish-deploy.timer as the deploy user.
# Env overrides (testing): APP_ROOT, API_URL, RAW_URL_BASE, STATE_DIRECTORY, DRY_RUN=1, WAIT_SECS.
set -euo pipefail
umask 077

ROOT=${APP_ROOT:-/srv/peni.sh}
ENV_FILE=$ROOT/.env
DATA=$ROOT/data
# deploy is effectively root (docker group) and data/ is writable from the containers, so every
# file this script trusts (state, staged and backed-up compose) lives in a private dir instead.
STATE=${STATE_DIRECTORY:-/var/lib/penish-deploy}
WAIT_SECS=${WAIT_SECS:-120}
RETRY_AFTER_MIN=${RETRY_AFTER_MIN:-10}
DRY_RUN=${DRY_RUN:-0}
DEFAULT_API_URL='https://api.github.com/repos/tfpickard/peni.sh/actions/workflows/ci.yml/runs?branch=main&status=success&event=push&per_page=1'
API_URL=${API_URL:-$DEFAULT_API_URL}
RAW_URL_BASE=${RAW_URL_BASE:-https://raw.githubusercontent.com/tfpickard/peni.sh}
COMPOSE=$ROOT/compose.yaml
compose_prev=
compose_swapped=0

log() { printf 'penish-deploy: %s\n' "$*"; }
err() { printf 'penish-deploy: ERROR: %s\n' "$*" >&2; }

# GNU stat first, BSD stat (macOS, for tests) second.
stat_owner_mode() { stat -c '%u %a' "$1" 2>/dev/null || stat -f '%u %Lp' "$1"; }

if [ -L "$STATE" ] || [ ! -d "$STATE" ] || [ "$(stat_owner_mode "$STATE")" != "$(id -u) 700" ]; then
  err "$STATE must be a real directory owned by uid $(id -u) with mode 700; refusing to run"
  exit 1
fi

# A symlink in the state dir means something other than this script wrote there.
refuse_symlink() {
  if [ -L "$1" ]; then
    err "$1 is a symlink; refusing to run"
    exit 1
  fi
}

# Reads a state file after the symlink check; prints nothing when absent.
read_state() {
  refuse_symlink "$STATE/$1"
  if [ -f "$STATE/$1" ]; then tr -d '[:space:]' <"$STATE/$1"; fi
}

# Write via a temp name and rename so a reader never sees a half-written sha.
write_state() {
  refuse_symlink "$STATE/$1"
  refuse_symlink "$STATE/$1.tmp"
  printf '%s\n' "$2" >"$STATE/$1.tmp"
  mv -f "$STATE/$1.tmp" "$STATE/$1"
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

# /run/lock is world-writable on Ubuntu; the fallbacks keep the script usable unprivileged.
lock_dir=/run/lock
[ -w "$lock_dir" ] || lock_dir=${XDG_RUNTIME_DIR:-/tmp}
exec 9>"$lock_dir/penish-deploy.lock"
flock -n 9 || exit 0

# Parsed rather than sourced: .env is not guaranteed to be valid shell.
env_get() {
  local line
  line=$(grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -n1 || true)
  line=${line#*=}
  line=${line#[\"\']}
  line=${line%[\"\']}
  printf '%s' "$line"
}

run() {
  if [ "$DRY_RUN" = 1 ]; then
    printf '+ %s\n' "$*"
  else
    "$@"
  fi
}

# The value ends up in .env and in image refs, so reject anything but a full sha.
valid_sha() { [[ $1 =~ ^[0-9a-f]{40}$ ]]; }

# State used to live in data/, which the containers can write, so only a strictly shaped
# deployed_sha is carried over; pinned_sha and failed_sha are not trusted from there.
migrate_old_state() {
  local old=$DATA/deployed_sha content
  [ ! -e "$STATE/deployed_sha" ] && [ ! -L "$STATE/deployed_sha" ] || return 0
  [ -f "$old" ] && [ ! -L "$old" ] || return 0
  content=$(tr -d '[:space:]' <"$old")
  if valid_sha "$content"; then
    log "migrating deployed_sha $content from $DATA to $STATE"
    if [ "$DRY_RUN" = 1 ]; then printf '+ write %s/deployed_sha\n' "$STATE"; else write_state deployed_sha "$content"; fi
  else
    err "ignoring old $old: not a 40-char sha"
  fi
  if [ -e "$DATA/pinned_sha" ] || [ -L "$DATA/pinned_sha" ]; then
    log "WARNING: ignoring old $DATA/pinned_sha; re-pin in $STATE/pinned_sha if needed"
  fi
}

set_image_tag() {
  if [ "$DRY_RUN" = 1 ]; then
    printf '+ set IMAGE_TAG=%s in %s\n' "$1" "$ENV_FILE"
  elif grep -q '^IMAGE_TAG=' "$ENV_FILE"; then
    # Rewrite in place rather than sed -i: the app root is not writable by deploy, only .env is.
    tmp=$(mktemp)
    sed "s/^IMAGE_TAG=.*/IMAGE_TAG=$1/" "$ENV_FILE" >"$tmp"
    cat "$tmp" >"$ENV_FILE"
    rm -f "$tmp"
  else
    printf '\nIMAGE_TAG=%s\n' "$1" >>"$ENV_FILE"
  fi
}

# The app root is owned by another user, so the file is overwritten in place (keeps its
# ownership; compose only reads it at deploy time). Staging and backup stay in $STATE.
sync_compose() {
  local sha=$1 tmp staged_sum
  tmp=$(mktemp "$STATE/compose.XXXXXX")
  if ! curl -fsSL --max-time 30 -o "$tmp" "$RAW_URL_BASE/$sha/compose.yaml"; then
    rm -f "$tmp"
    err "could not fetch compose.yaml for $sha; aborting deploy"
    return 1
  fi
  log "fetched compose.yaml for $sha"
  # A broken file must never reach the box: validate with the real .env before touching anything.
  if ! docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" -f "$tmp" config -q; then
    rm -f "$tmp"
    err "compose.yaml for $sha failed validation; aborting deploy"
    return 1
  fi
  log "compose.yaml for $sha validated"
  staged_sum=$(sha256_of "$tmp")
  if cmp -s "$tmp" "$COMPOSE" 2>/dev/null; then
    rm -f "$tmp"
    return 0
  fi
  compose_prev=$STATE/compose.yaml.prev
  refuse_symlink "$compose_prev"
  if [ "$DRY_RUN" = 1 ]; then
    printf '+ back up %s to %s, then replace it with the fetched compose.yaml\n' "$COMPOSE" "$compose_prev"
  else
    if [ -f "$COMPOSE" ]; then cat "$COMPOSE" >"$compose_prev"; else : >"$compose_prev"; fi
    # Install exactly the bytes that were validated.
    if [ "$(sha256_of "$tmp")" != "$staged_sum" ]; then
      rm -f "$tmp"
      err "staged compose.yaml changed after validation; aborting deploy"
      return 1
    fi
    cat "$tmp" >"$COMPOSE"
    compose_swapped=1
  fi
  rm -f "$tmp"
}

restore_compose() {
  [ "$compose_swapped" = 1 ] || return 0
  cat "$compose_prev" >"$COMPOSE"
  compose_swapped=0
  log "restored previous compose.yaml"
}

api_healthy() {
  local health
  # Newer compose prints one JSON object per line, older prints an array; slurp handles both.
  health=$(docker compose ps api --format json 2>/dev/null | jq -rs 'flatten | .[0].Health // ""' 2>/dev/null || true)
  [ "$health" = healthy ]
}

wait_healthy() {
  local waited=0
  while [ "$waited" -lt "$WAIT_SECS" ]; do
    api_healthy && return 0
    sleep 2
    waited=$((waited + 2))
  done
  return 1
}

cd "$ROOT"
[ -f "$ROOT/compose.yaml" ] || [ "$DRY_RUN" = 1 ] || exit 0

migrate_old_state

pinned=$(read_state pinned_sha)
if [ -n "$pinned" ]; then
  target=$pinned
else
  token=$(env_get GH_READ_TOKEN)
  # Unauthenticated calls would exhaust the rate limit at one poll per minute, so do nothing instead.
  if [ -z "$token" ] && [ "$API_URL" = "$DEFAULT_API_URL" ]; then
    exit 0
  fi
  auth=()
  [ -z "$token" ] || auth=(-H "Authorization: Bearer $token")
  if ! resp=$(curl -fsS --max-time 20 -H 'Accept: application/vnd.github+json' "${auth[@]}" "$API_URL"); then
    err "could not query $API_URL"
    exit 1
  fi
  target=$(printf '%s' "$resp" | jq -r '.workflow_runs[0].head_sha // empty')
  # No successful run yet is not an error.
  [ -n "$target" ] || exit 0
fi

if ! valid_sha "$target"; then
  err "refusing malformed sha: $target"
  exit 1
fi

deployed=$(read_state deployed_sha)
if [ -n "$deployed" ] && ! valid_sha "$deployed"; then
  err "ignoring malformed $STATE/deployed_sha"
  deployed=
fi
[ "$target" != "$deployed" ] || exit 0

# A sha that failed its health check is retried only after a pause, not every minute.
if [ "$(read_state failed_sha)" = "$target" ] \
  && [ -n "$(find "$STATE/failed_sha" -mmin "-$RETRY_AFTER_MIN" 2>/dev/null)" ]; then
  exit 0
fi

log "deploying $target (was ${deployed:-none})"
sync_compose "$target" || exit 1
set_image_tag "$target"

if ! run docker compose pull; then
  err "pull failed for $target; running containers untouched"
  [ -z "$deployed" ] || set_image_tag "$deployed"
  restore_compose
  exit 1
fi

failed=0
run docker compose up -d --remove-orphans || failed=1
if [ "$failed" = 0 ]; then
  if [ "$DRY_RUN" = 1 ]; then
    printf '+ wait up to %ss for api healthy\n' "$WAIT_SECS"
  else
    wait_healthy || failed=1
  fi
fi

if [ "$failed" = 1 ]; then
  err "DEPLOY FAILED for $target: api not healthy within ${WAIT_SECS}s"
  write_state failed_sha "$target"
  if [ -n "$deployed" ]; then
    err "rolling back to $deployed"
    set_image_tag "$deployed"
    restore_compose
    run docker compose up -d --remove-orphans || err "rollback up failed; manual intervention needed"
  else
    err "no previous deploy to roll back to"
  fi
  exit 1
fi

if [ "$DRY_RUN" = 1 ]; then
  printf '+ write %s/deployed_sha = %s\n' "$STATE" "$target"
else
  write_state deployed_sha "$target"
  rm -f "$STATE/failed_sha"
fi
log "deployed $target"

# Each deploy pulls a torch-sized image; without this the disk fills in days.
run docker image prune -af --filter until=72h >/dev/null || true
